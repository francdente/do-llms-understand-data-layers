# Task LLM configuration
LLM_API_KEY="your-api-key"
LLM_MODEL="openai/gpt-5.4"
# Optional: base URL for self-hosted models (e.g. http://localhost:11434 for Ollama)
LLM_BASE_URL=""

# Judge LLM configuration (used for FREE prompt evaluation)
LLM_JUDGE_MODEL="openai/gpt-5.4"
LLM_JUDGE_API_KEY="your-judge-api-key"
# Optional
LLM_JUDGE_BASE_URL=""

# Output configuration
LLM_MAX_TOKENS=64000
# Set to "true" to disable chain-of-thought reasoning (for models that support it)
LLM_DISABLE_THINKING=true
